# Copy to ".env" to override defaults. ".env" is git-ignored; never commit it.
# Every variable is optional: the values below are the defaults.

# Address the backend listens on. 127.0.0.1 = this laptop only.
IOT_HOST=127.0.0.1
IOT_PORT=8000

# Browser origins allowed to call the HTTP API (comma-separated).
# The default is the Vite dev server.
IOT_CORS_ORIGINS=http://localhost:5173

# Run mode. "simulation" runs the live simulator. "hardware" does not exist yet: the
# backend then serves status only and refuses every presenter control.
# Update (Phase 6-prep): "hardware" now reads node C's USB serial port (IOT_SERIAL_PORT).
IOT_MODE=simulation

# Hardware mode. The port node C is on: COM3 on Windows, /dev/cu.usbserial-0001 (or similar) on
# macOS, or a pyserial URL such as socket://127.0.0.1:7777 for the fake C device.
# List the ports with: uv run python -m iot_backend.serial_probe --list
IOT_SERIAL_PORT=
IOT_SERIAL_BAUD=115200
# In simulation mode, make the simulated C speak the serial line format ("direct" or "serial").
IOT_LIVE_TRANSPORT=direct

# Seconds between WebSocket heartbeat events.
IOT_HEARTBEAT_INTERVAL_SECONDS=2

# Live simulation (Phase 5a)
# Start pacing the simulation against the wall clock when the server starts.
IOT_LIVE_AUTOSTART=true
# Scenario file (name without .json) in the repository's scenarios/ folder.
IOT_LIVE_SCENARIO=live-demo
# Simulated seconds per real second (0.1 to 1000).
IOT_LIVE_SPEED=1
# How many state-changing events are kept for catch-up (GET /api/events).
IOT_LIVE_HISTORY=2000
# Override the scenarios folder (empty = the repository's scenarios/).
IOT_SCENARIOS_DIR=

# Run history (Phase 10): a SQLite file with every run's configuration, events and readings.
# Empty = no history is kept. List and export with:
#   uv run python -m iot_backend.history list
#   uv run python -m iot_backend.history export RUN_ID --out-dir exports
IOT_HISTORY_DB=
IOT_HISTORY_MAX_RUNS=10
IOT_HISTORY_MAX_EVENTS=20000
IOT_HISTORY_MAX_READINGS=10000

# Routing policy (Phase 9): immediate_rtt (the Phase 4 behaviour), lowest_delay or
# highest_reliability. Empty = the scenario's controller section. It can also be changed
# while running with POST /api/policy.
IOT_ROUTING_POLICY=
