# Copy to ".env" to override defaults. ".env" is git-ignored; never commit it.
# Every variable is optional: the values below are the defaults.

# Address the backend listens on. 127.0.0.1 = this laptop only.
IOT_HOST=127.0.0.1
IOT_PORT=8000

# Browser origins allowed to call the HTTP API (comma-separated).
# The default is the Vite dev server.
IOT_CORS_ORIGINS=http://localhost:5173

# Run mode. Only "simulation" exists in Phase 0.
IOT_MODE=simulation

# Seconds between WebSocket heartbeat events.
IOT_HEARTBEAT_INTERVAL_SECONDS=2
