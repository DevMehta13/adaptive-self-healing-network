{
  "name": "buffer-overflow",
  "description": "SIMULATED SETTING, not a measurement: link delays are configured so that A-B and B-C (10 ms one way) are cheaper than A-D and D-C (25 ms one way). Readings every 200 ms and a buffer of 20 entries; the controller is away from 15 s to 75 s. The oldest entries are dropped and counted, readings are preferred over reports, and memory stays bounded.",
  "seed": 42,
  "duration_s": 100,
  "routing": "controller",
  "settings": {
    "probe_interval_ms": 1000,
    "local_failover": true,
    "failover_t1": true,
    "failover_t2_k": 3,
    "telemetry_interval_ms": 5000,
    "controller_timeout_ms": 3000,
    "buffer_capacity": 20,
    "reading_interval_ms": 200
  },
  "controller": {
    "epoch": 1000,
    "backup_next_hops": true,
    "heartbeat_interval_ms": 1000
  },
  "links": {
    "A->B": {
      "delay_ms": 10
    },
    "B->A": {
      "delay_ms": 10
    },
    "B->C": {
      "delay_ms": 10
    },
    "C->B": {
      "delay_ms": 10
    },
    "A->D": {
      "delay_ms": 25
    },
    "D->A": {
      "delay_ms": 25
    },
    "D->C": {
      "delay_ms": 25
    },
    "C->D": {
      "delay_ms": 25
    }
  },
  "actions": [
    {
      "at_ms": 15000,
      "action": "detach_gateway"
    },
    {
      "at_ms": 75000,
      "action": "attach_gateway"
    }
  ]
}
